{
  // The game and its high scores, at scoundrel.alexanderk.dev.
  "name": "scoundrel",
  "compatibility_date": "2026-10-20",
  "main": "worker/index.js",
  // Before every deploy: run the rules tests, then build the game into dist/.
  "build": { "command": "npm test && npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only the high-score API goes to the script; the game is plain files.
    "run_worker_first": ["/api/*"]
  },
  // The high scores. Cloudflare creates the database on the first deploy;
  // the tables come from migrations/ (npx wrangler d1 migrations apply scoundrel --remote).
  "d1_databases": [{ "binding": "DB", "database_name": "scoundrel", "migrations_dir": "migrations" }],
  // Slows down spam: 20 new games and 5 score saves a minute per visitor.
  "ratelimits": [
    { "name": "GAME_LIMITER", "namespace_id": "2001", "simple": { "limit": 20, "period": 60 } },
    { "name": "SCORE_LIMITER", "namespace_id": "2002", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
