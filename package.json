{
  "name": "simple-scoundrel",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply scoundrel --remote",
    "dev:full": "npm run build && wrangler d1 migrations apply scoundrel --local && wrangler dev"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.57.2",
    "vite": "8.3.6",
    "wrangler": "4.158.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fontsource/cinzel": "5.3.0"
  }
}
